{
  "name": "invisible-sdk-nextjs-privy-example",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack && node scripts/mirror-static-export.mjs",
    "start": "node scripts/serve-static.mjs out 3000",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "check:static": "test -f out/index.html && test -f .vercel/output/static/index.html && test -f dist/index.html",
    "audit:high": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@invisible-labs/sdk": "0.0.1",
    "@privy-io/react-auth": "3.32.1",
    "@solana-program/memo": "0.11.2",
    "@solana-program/system": "0.12.2",
    "@solana-program/token": "0.14.0",
    "@solana/kit": "6.10.0",
    "lucide-react": "1.21.0",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "overrides": {
    "@walletconnect/core": "2.23.9",
    "@walletconnect/ethereum-provider": "2.23.9",
    "@walletconnect/sign-client": "2.23.9",
    "@walletconnect/universal-provider": "2.23.9",
    "@walletconnect/utils": "2.23.9",
    "viem": "2.52.2",
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "4.1.9"
  }
}
